{
  "name": "neofit-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "node --import tsx --test tests/*.test.ts && npm run test:nutrition-schema",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "check": "npm run test && npm run typecheck && npm run doctor",
    "test:nutrition-schema": "node --no-warnings=ExperimentalWarning scripts/validate-nutrition-schema.mjs"
  },
  "dependencies": {
    "expo": "~57.0.9",
    "expo-asset": "~57.0.7",
    "expo-constants": "~57.0.7",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-manipulator": "~57.0.7",
    "expo-image-picker": "~57.0.7",
    "expo-linking": "~57.0.1",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "expo-doctor": "1.20.1",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  }
}
