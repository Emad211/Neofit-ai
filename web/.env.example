# Local development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_VERCEL_ENV=development

# Supabase browser-safe configuration.
# Copy values from the target Supabase Project into local/Vercel environment
# settings. Do not commit key values to this file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Vercel Preview should set:
# NEXT_PUBLIC_VERCEL_ENV=preview
# NEXT_PUBLIC_APP_URL=https://<preview-domain>

# Vercel Production should set:
# NEXT_PUBLIC_VERCEL_ENV=production
# NEXT_PUBLIC_APP_URL=https://<production-domain>

# Server-only secrets must never use the NEXT_PUBLIC_ prefix or enter Browser code.

# AI BYOK credential vault (server-only; Preview/Production secret, never NEXT_PUBLIC_).
# Generate exactly 32 random bytes and base64-encode them, for example:
#   openssl rand -base64 32
AI_CREDENTIAL_ENCRYPTION_KEY=

# Auth recovery-intent HMAC key (server-only; keep separate from the AI key).
# Generate exactly 32 random bytes and base64-encode them:
#   openssl rand -base64 32
AUTH_RECOVERY_INTENT_KEY=
