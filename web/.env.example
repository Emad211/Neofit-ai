# Local development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_VERCEL_ENV=development

# Vercel Preview should set:
# NEXT_PUBLIC_VERCEL_ENV=preview
# NEXT_PUBLIC_APP_URL=https://<preview-domain>

# Vercel Production should set:
# NEXT_PUBLIC_VERCEL_ENV=production
# NEXT_PUBLIC_APP_URL=https://<production-domain>

# No Supabase or AvalAI secret is introduced in Stage 2.
# Server-only secrets must never use the NEXT_PUBLIC_ prefix.
