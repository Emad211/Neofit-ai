{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neofit.local/schemas/food-profile-promotion-v1.json",
  "title": "NeoFit Food Profile Promotion Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "source", "records"],
  "properties": {
    "format": {
      "const": "neofit-food-profile-promotion"
    },
    "schemaVersion": {
      "const": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "version", "evidenceTier"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 2,
          "maxLength": 300
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "evidenceTier": {
          "enum": ["verified_source", "digital_consensus"]
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceRecordId", "food"],
        "properties": {
          "sourceRecordId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "food": {
            "$ref": "#/$defs/food"
          }
        }
      }
    }
  },
  "$defs": {
    "food": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nameFa",
        "nameEn",
        "category",
        "portionLabelFa",
        "portionLabelEn",
        "portionGrams",
        "calories",
        "proteinG",
        "carbsG",
        "fatG",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "nameFa": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "nameEn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "aliasesFa": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "default": []
        },
        "aliasesEn": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "default": []
        },
        "category": {
          "enum": [
            "stew",
            "rice",
            "kebab",
            "soup",
            "breakfast",
            "street_food",
            "bread",
            "dessert",
            "dairy_beverage",
            "ingredient",
            "custom"
          ]
        },
        "portionLabelFa": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "portionLabelEn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "portionGrams": {
          "type": "number",
          "minimum": 1,
          "maximum": 5000
        },
        "calories": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "proteinG": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "carbsG": {
          "type": "number",
          "minimum": 0,
          "maximum": 2000
        },
        "fatG": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "variabilityPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 80,
          "default": 20
        },
        "confidence": {
          "enum": ["medium", "high"]
        },
        "notesFa": {
          "type": "string",
          "maxLength": 700,
          "default": ""
        },
        "notesEn": {
          "type": "string",
          "maxLength": 700,
          "default": ""
        }
      }
    }
  }
}
