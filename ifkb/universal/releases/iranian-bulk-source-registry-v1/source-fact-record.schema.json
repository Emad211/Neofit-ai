{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neofit.local/schemas/ifkb-source-fact-record-v1.json",
  "title": "IFKB source fact record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "recordId",
    "canonId",
    "sourceCollectionId",
    "sourceUrl",
    "candidateTitle",
    "matchScore",
    "matchReason",
    "exactIdentityStatus",
    "reuseReviewStatus",
    "rawRecipeTextStored",
    "structuredFactsExtracted",
    "ingredients",
    "reviewers",
    "nutritionValuesAllowed",
    "promotionEligible"
  ],
  "properties": {
    "format": { "const": "ifkb-source-fact-record" },
    "version": { "const": "1.0.0" },
    "recordId": { "type": "string", "pattern": "^IFKB-SFR-[a-f0-9]{20}$" },
    "canonId": { "type": "string", "pattern": "^IFKB-CANON-[0-9]{5}$" },
    "sourceCollectionId": { "type": "string", "minLength": 1 },
    "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "candidateTitle": { "type": "string", "minLength": 1 },
    "matchScore": { "type": "number", "minimum": 0 },
    "matchReason": { "type": "string", "minLength": 1 },
    "exactIdentityStatus": { "enum": ["unreviewed", "confirmed", "rejected", "ambiguous"] },
    "reuseReviewStatus": { "enum": ["unreviewed", "allowed_structured_facts_only", "permission_required", "rejected"] },
    "publisher": { "type": ["string", "null"] },
    "independenceGroup": { "type": ["string", "null"] },
    "accessedAt": { "type": ["string", "null"], "format": "date-time" },
    "declaredServings": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "cookedBatchWeightG": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "servingWeightG": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "rawRecipeTextStored": { "const": false },
    "structuredFactsExtracted": { "type": "boolean" },
    "ingredients": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceLabel", "amount", "unit", "grams", "ingredientId", "mappingStatus"],
        "properties": {
          "sourceLabel": { "type": "string", "minLength": 1 },
          "amount": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "unit": { "type": ["string", "null"] },
          "grams": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "state": { "type": ["string", "null"] },
          "ingredientId": { "type": ["string", "null"] },
          "mappingStatus": { "enum": ["unmapped", "candidate", "confirmed", "rejected"] }
        }
      }
    },
    "reviewers": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "adjudicator": { "type": ["string", "null"] },
    "nutritionValuesAllowed": { "const": false },
    "promotionEligible": { "const": false },
    "notes": { "type": ["string", "null"] }
  }
}
