{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ifkb.local/schemas/mobile-capture-payload-v0.12.1.json",
  "title": "IFKB Mobile Field Capture Payload",
  "type": "object",
  "required": [
    "session_id",
    "assignment_id",
    "canon_id",
    "consent_id",
    "dish_instance_id",
    "shots",
    "privacy_review_status"
  ],
  "properties": {
    "session_id": {"type": "string"},
    "assignment_id": {"type": "string"},
    "canon_id": {"type": "string"},
    "typed_food_name": {"type": ["string", "null"]},
    "consent_id": {"type": "string"},
    "dish_instance_id": {"type": "string"},
    "batch_id": {"type": ["string", "null"]},
    "recipe_version_id": {"type": ["string", "null"]},
    "total_edible_weight_g": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "component_weights": {
      "type": ["object", "null"],
      "additionalProperties": {"type": "number", "minimum": 0}
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["shot_id", "angle", "local_sha256"],
        "properties": {
          "shot_id": {"type": "string"},
          "angle": {"enum": ["top", "45deg", "side", "closeup", "multi_item_scene"]},
          "local_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "pixel_width": {"type": "integer", "minimum": 1},
          "pixel_height": {"type": "integer", "minimum": 1}
        }
      }
    },
    "privacy_review_status": {"enum": ["pending", "accepted", "rejected"]},
    "identity_review_status": {"enum": ["pending", "accepted", "rejected"]},
    "ground_truth_source": {"enum": ["recipe", "kitchen_log", "expert_review", "user_only"]}
  }
}
